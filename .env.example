# FINNISH - Environment Configuration
# Copy this file to .env and fill in your values
# All variables are optional and have sensible defaults

# =============================================================================
# APPLICATION
# =============================================================================
VITE_APP_VERSION=0.1.0

# =============================================================================
# API CONFIGURATION
# =============================================================================
VITE_API_URL=http://localhost:3000
VITE_API_TIMEOUT=30000

# =============================================================================
# AI SERVICE CONFIGURATION
# =============================================================================
VITE_CLAUDE_API_KEY=
VITE_CLAUDE_MODEL=claude-sonnet-4-20250514
VITE_OPENAI_API_KEY=
VITE_OPENAI_MODEL=gpt-4-turbo-preview
VITE_OPENAI_BASE_URL=https://api.openai.com/v1
# Optional: point to your server proxy for LLM calls (if set, client will use this instead of base URL)
VITE_OPENAI_PROXY_URL=
VITE_FALAI_API_KEY=
VITE_AI_MAX_TOKENS=4096
VITE_AI_TEMPERATURE=0.7
VITE_AI_RPM=60
VITE_AI_RETRY_ATTEMPTS=3
VITE_AI_RETRY_DELAY=1000

# =============================================================================
# LLM PROXY SERVER (optional)
# =============================================================================
# Used by server/llm-proxy.mjs
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
CORS_ORIGIN=*

# =============================================================================
# FEATURE FLAGS
# =============================================================================
VITE_FEATURE_AI_GENERATION=true
VITE_FEATURE_COLLABORATION=false
VITE_FEATURE_CLOUD_SYNC=false
VITE_FEATURE_EXPERIMENTAL=false
VITE_FEATURE_DEBUG=false
VITE_FEATURE_ANALYTICS=false
VITE_FEATURE_OFFLINE=true
VITE_FEATURE_AGENT_MODE=true

# =============================================================================
# EDITOR CONFIGURATION
# =============================================================================
VITE_EDITOR_WIDTH=1920
VITE_EDITOR_HEIGHT=1080
VITE_EDITOR_MAX_HISTORY=50
VITE_EDITOR_GRID_SIZE=10
VITE_EDITOR_SNAP_THRESHOLD=5
VITE_EDITOR_AUTOSAVE=true
VITE_EDITOR_AUTOSAVE_INTERVAL=30000
VITE_EDITOR_MAX_OBJECTS=10000
VITE_EDITOR_RENDER_THROTTLE=16

# =============================================================================
# EXPORT CONFIGURATION
# =============================================================================
VITE_EXPORT_DPI=300
VITE_EXPORT_QUALITY=90
VITE_EXPORT_FORMAT=png

# =============================================================================
# IMPORT CONFIGURATION
# =============================================================================
# Maximum file size in bytes (default: 50MB)
VITE_IMPORT_MAX_SIZE=52428800

# =============================================================================
# DOCKER CONFIGURATION
# =============================================================================
# Port for production server (default: 8080)
PORT=8080

# Port for development server (default: 5173)
DEV_PORT=5173

# Docker registry for pushing images
# Example: docker.io/username or ghcr.io/username
REGISTRY=

# Image version tag
VERSION=latest
