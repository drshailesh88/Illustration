{
  "name": "finnish",
  "version": "0.1.0",
  "description": "AI-powered scientific illustration tool - Kill Adobe Illustrator, BioRender, and Napkin.AI for academics",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "fabric": "^6.5.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "mermaid": "^11.4.0",
    "katex": "^0.16.11",
    "zustand": "^5.0.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.8.69",
    "svg-parser": "^2.0.4",
    "potrace": "^2.1.8",
    "uuid": "^11.0.3",
    "lodash-es": "^4.17.21",
    "clsx": "^2.1.1"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "@vitejs/plugin-react": "^4.3.4",
    "vitest": "^2.1.8",
    "@vitest/coverage-v8": "^2.1.8",
    "@testing-library/react": "^16.1.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@types/katex": "^0.16.7",
    "@types/lodash-es": "^4.17.12",
    "@types/uuid": "^10.0.0",
    "eslint": "^9.17.0",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "eslint-plugin-react": "^7.37.3",
    "eslint-plugin-react-hooks": "^5.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "illustration",
    "scientific",
    "academic",
    "svg",
    "editor",
    "ai",
    "latex",
    "tikz",
    "fabric.js"
  ],
  "license": "MIT"
}
